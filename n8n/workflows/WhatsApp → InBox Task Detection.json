      "id": "c3378aea-d67c-4c31-9865-48df6cb91abd",
      "name": "Extract Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        560,
        160
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.6-luna",
          "cachedResultName": "gpt-5.6-luna"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You analyze a single WhatsApp message and decide whether it contains a real, actionable task for the recipient.\nA task is something the recipient must DO or remember to do: assignments, calls, sending things, meetings, purchases, deadlines, reminders.\nNOT tasks: greetings (\"hi\", \"how are you\"), acknowledgements (\"okay\", \"thanks\"), casual chatting, questions with no action for the recipient, or statements requiring no action.\nOutput ONLY the structured object.\nRules:\n- If it is not a task: is_task=false and all other fields null.\n- If it is a task: is_task=true and fill task_title (short imperative title) and description.\n- due_date: format YYYY-MM-DD. due_time: format HH:MM (24h).\n- NEVER invent a due date or time. If the message gives none, set them to null.\n- Resolve relative words (\"today\", \"tomorrow\", \"Friday\", \"tonight\") using the provided MESSAGE_TIMESTAMP as the reference \"now\". Never use any other clock.\n- priority: one of \"low\", \"medium\", \"high\" (default \"medium\" when it is a task and no urgency is stated)."
            },
            {
              "content": "=MESSAGE_TIMESTAMP: {{ $json.timestamp }}\nMESSAGE_TEXT: {{ $json.message_text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 500,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "task_detection",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"is_task\":{\"type\":\"boolean\"},\"task_title\":{\"type\":[\"string\",\"null\"]},\"description\":{\"type\":[\"string\",\"null\"]},\"due_date\":{\"type\":[\"string\",\"null\"]},\"due_time\":{\"type\":[\"string\",\"null\"]},\"priority\":{\"type\":[\"string\",\"null\"],\"enum\":[\"low\",\"medium\",\"high\",null]}},\"required\":[\"is_task\",\"task_title\",\"description\",\"due_date\",\"due_time\",\"priority\"]}",
              "strict": true
            }
          }
        }
      },
      "id": "386050be-82ff-4058-b119-d534dddde66e",
      "name": "AI Task Analyzer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        816,
        160
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
