          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You analyze a single email and decide whether it contains a clear, actionable task, assignment, deadline, reminder, follow-up, or responsibility for the recipient.\n\nDo NOT classify every email as a task. Ignore normal conversations, newsletters, advertisements, spam, receipts, promotional emails, and purely informational emails that carry no actionable requirement.\n\nIf there is a clear actionable task, set isTask=true and extract:\n- title: a short task title\n- deadline: the due date as written (e.g. \"Friday\", \"2026-10-03\") or \"\" if none\n- time: the due time as written (e.g. \"6:00 PM\") or \"\" if none\n- category: one of \"Study\", \"Work\", or \"Personal\" (best guess)\n- description: one short sentence describing what must be done\n- confidence: a number between 0 and 1 for how confident you are it is an actionable task\n\nIf there is NO actionable task, set isTask=false and return the other fields with empty values: title=\"\", deadline=\"\", time=\"\", category=\"Personal\", description=\"\", confidence=0. Always return every field."
            },
            {
              "content": "=From: {{ $json.sender }}\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.body }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "detected_task",
              "schema": "{\"type\":\"object\",\"properties\":{\"isTask\":{\"type\":\"boolean\"},\"title\":{\"type\":\"string\"},\"deadline\":{\"type\":\"string\"},\"time\":{\"type\":\"string\"},\"category\":{\"type\":\"string\",\"enum\":[\"Study\",\"Work\",\"Personal\"]},\"description\":{\"type\":\"string\"},\"confidence\":{\"type\":\"number\"}},\"required\":[\"isTask\",\"title\",\"deadline\",\"time\",\"category\",\"description\",\"confidence\"],\"additionalProperties\":false}",
              "strict": true
            }
          },
          "temperature": 0
        }
      },
