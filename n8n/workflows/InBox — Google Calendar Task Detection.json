    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5"
        },
        "messages": {
          "values": [
            {
              "content": "=Analyze this Google Calendar event and decide whether it is an actionable task for the user (task, assignment, deadline, reminder, viva, presentation, meeting requiring attendance, appointment, responsibility, or scheduled activity needing the user's attention).\n\nDo NOT classify as a task: holidays, birthdays without an actionable reminder, casual/social events, informational entries, or anything with no meaningful action or responsibility.\n\nEvent:\n- ID: {{ $json.eventId }}\n- Title: {{ $json.title }}\n- Description: {{ $json.description }}\n- Start: {{ $json.startTime }}\n- End: {{ $json.endTime }}\n- Location: {{ $json.location }}\n- Organizer: {{ $json.organizer }}\n- Meeting link: {{ $json.meetingLink }}"
            }
          ]
        },
        "options": {
          "system": "You are a strict JSON classifier for a task-detection inbox. Reply with ONLY a single JSON object, no markdown, no extra text.\n\nThe JSON object MUST contain EXACTLY these keys:\nisTask (boolean), title (string), deadline (string, human-readable date like \"October 24\"), time (string, human-readable like \"6:00 PM\"), category (string, one of \"Study\", \"Work\", \"Personal\" — empty when isTask is false), source (always \"Google Calendar\"), message_id (the calendar event ID given to you), sender (organizer email), description (one-sentence summary; empty when isTask is false), confidence (number 0-1; 0 when isTask is false).\n\nCategory rules: academic/study/exam/viva/lecture → \"Study\"; client/work/professional → \"Work\"; personal/health/social-but-actionable → \"Personal\".\n\nWhen isTask is false: title, deadline, time, category, sender, description are empty strings, confidence is 0, but message_id must still be the event ID.",
          "maxTokens": 512
        }
      },
      "id": "0e828b51-b93d-482c-82b9-a12ef55f8944",
      "name": "AI Task Detection",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1184,
        192
      ],
      "credentials": {
        "anthropicApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const eventId = $('Restore Event Fields').item.json.eventId;\nconst blocks = $json.content;\nlet text = '';\nif (Array.isArray(blocks)) {\n  text = blocks.filter(b => b && b.type === 'text').map(b => b.text).join('');\n} else if (typeof blocks === 'string') {\n  text = blocks;\n}\ntext = text.replace(/^```(json)?/im, '').replace(/```\\s*$/m, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  return [{ json: { isTask: false, message_id: eventId, ai_error: true, ai_raw: text.slice(0, 500) } }];\n}\nif (typeof parsed.isTask !== 'boolean') {\n  return [{ json: { isTask: false, message_id: eventId, ai_error: true, ai_raw: text.slice(0, 500) } }];\n}\nparsed.message_id = parsed.message_id || eventId;\nparsed.source = 'Google Calendar';\nif (!parsed.isTask) { parsed.ai_error = false; }\nreturn [{ json: parsed }];"
      },
